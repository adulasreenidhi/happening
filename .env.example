# Copy this file to .env and set strong, unique values before starting Compose.
MYSQL_DATABASE=happening_db
MYSQL_ROOT_PASSWORD=
DB_USERNAME=happening_app
DB_PASSWORD=
JWT_SECRET=

# Optional. Live AI-provider features require both this key and AI_ASSISTANT_ENABLED=true.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AI_ASSISTANT_ENABLED=false

# Public frontend origin used by backend CORS.
FRONTEND_ORIGIN=http://localhost:8081
JWT_EXPIRATION_MS=3600000
JPA_DDL_AUTO=update

# Host-only development ports. Use a TLS reverse proxy for public deployments.
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=8081
BACKEND_PORT=8080
MYSQL_HOST_PORT=3307
